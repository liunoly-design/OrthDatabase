    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "jsdom": "^29.1.1",
    "miniprogram-api-typings": "^5.3.1",
    "miniprogram-simulate": "^1.7.0",
    "typescript": "^6.0.3"
