{
  "name": "orth-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "migrate": "node src/migrate.ts",
    "import:price": "node src/import-price.ts",
    "start": "node src/start.ts",
    "start:governance": "node src/start-governance.ts",
    "start:operations": "node src/start-operations.ts",
    "start:worker": "node src/start-worker.ts",
    "start:application": "node src/application/start.ts",
    "build:service": "tsc --ignoreConfig --target ES2023 --module NodeNext --strict --skipLibCheck --types node --rewriteRelativeImportExtensions --rootDir src",
    "build:governance": "npm run build:service -- --outDir dist/governance src/start-governance.ts",
    "build:operations": "npm run build:service -- --outDir dist/operations src/start-operations.ts",
    "build:worker": "npm run build:service -- --outDir dist/worker src/start-worker.ts",
    "test:governance-api": "node --test --test-name-pattern='独立治理 API' test/governance.test.ts",
    "test:worker": "node --test --test-name-pattern='独立 Worker' test/governance.test.ts",
    "test:governance": "node --test test/governance.test.ts test/permissions.test.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p miniprogram/tsconfig.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "jsdom": "^29.1.1",
    "miniprogram-api-typings": "^5.3.1",
    "miniprogram-simulate": "^1.7.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "miniprogram-simulate": {
      "postcss": "8.5.33"
    }
  }
}
