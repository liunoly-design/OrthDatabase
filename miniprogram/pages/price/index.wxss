page {
  background: #f3f7f6;
  color: #162b28;
  font-size: 30rpx;
  line-height: 1.55;
}

.page { padding: 30rpx; }
.card {
  background: #fff;
  border: 1px solid #d4e2df;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
}
.label { display: block; color: #41635d; font-size: 26rpx; }
.title { font-size: 34rpx; font-weight: 650; margin-bottom: 10rpx; }
.amount { font-size: 52rpx; font-weight: 750; color: #07584e; margin-bottom: 12rpx; }
.context, .location { color: #36514c; margin-top: 8rpx; }
.source { margin-top: 18rpx; }
.error { color: #9e3025; }
input { border-bottom: 1px solid #829c96; min-height: 76rpx; }
button { margin: 18rpx 0 0; background: #e2f2ee; color: #07584e; }

.context, .location { font-size: 26rpx; overflow-wrap: anywhere; }
.filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}
.filter { background: #f3f7f6; border-radius: 12rpx; overflow-wrap: anywhere; padding: 12rpx 16rpx; }
.scope { color: #07584e; margin-top: 18rpx; overflow-wrap: anywhere; }
.search-button { background: #07584e; color: #fff; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.actions button { margin: 0; }
